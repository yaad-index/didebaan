# Copy to .env and adjust. NEVER commit .env. docker compose reads these for
# variable substitution; the didebaan binary also reads DIDEBAAN_* directly
# (config layers as file < env < flag).

# Which input adapter to collect from (see `didebaan adapters`).
DIDEBAAN_ADAPTER=claude-code

# OTLP/gRPC endpoint of the downstream collector (host:port). Leave unset to use
# the OpenTelemetry SDK's own OTEL_EXPORTER_OTLP_* env defaults.
DIDEBAAN_OTLP_ENDPOINT=localhost:4317

# Use plaintext gRPC instead of TLS. Appropriate for a local collector on the
# loopback interface; leave unset (false) to use TLS.
# DIDEBAAN_OTLP_INSECURE=true
